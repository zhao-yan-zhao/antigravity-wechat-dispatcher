{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "WeChat Dispatcher & Telemetry Panel - 默认配置模板示例",
  "token": "antigravity_token",
  "autoDispatch": true,
  "autoStartWechatBot": true,
  "enableWebServer": false,
  "xmlPort": 18765,
  "targetMode": "code",
  "enableIntentRouting": true,
  "enableAIIntentCheck": true,
  "aiIntentConfirmTimeoutSec": 300,
  "activeConversationId": "",
  "pendingSwitchConvId": "",
  "currentProject": "default",
  "waitForAgentReply": true,
  "waitReplyTimeoutSec": 150,
  "notifyChannel": "none",
  "notifyWebhookUrl": "",
  "notifyWecomUrl": "",
  "notifyPushPlusToken": "",
  "notifyServerChanKey": "",
  "feishuWebhookUrl": "",
  "feishuSecret": "",
  "feishuAppId": "",
  "feishuAppSecret": "",
  "feishuVerificationToken": "",
  "feishuEncryptKey": "",
  "feishuNotifyOnDispatch": false,
  "llmProvider": "deepseek",
  "deepseekApiKey": "your_deepseek_api_key_here",
  "adminWhitelist": ["admin_wechat_id_here"]
}
